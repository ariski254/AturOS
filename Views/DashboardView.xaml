<UserControl x:Class="AturOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ringkasan Sistem" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Pantau performa CPU, memori RAM, dan kapasitas penyimpanan secara real-time."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Quick Action Button -->
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="36" Click="BtnOptimizeNow_Click"
                        ToolTip="Bersihkan memori dan file sampah sementara">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFlash}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Optimalkan Sekarang" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Notification / Status Banner -->
            <Border x:Name="NotificationBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="BannerIcon" Data="{StaticResource IconCheck}" Fill="{StaticResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BannerText" Grid.Column="1" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3 Preset Profil Performa Utama -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Profil Performa Aktif" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Pilih mode kerja sistem sesuai kebutuhan Anda." Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Profile 1: Daily Balance -->
                        <RadioButton x:Name="RadioDaily" Grid.Column="0" Style="{StaticResource NavButton}" Height="54" Padding="12,8" Click="RadioProfile_Click" Tag="Daily">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Seimbang (Harian)" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="Hemat daya &amp; animasi normal" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Profile 2: Productivity -->
                        <RadioButton x:Name="RadioWork" Grid.Column="2" Style="{StaticResource NavButton}" Height="54" Padding="12,8" Click="RadioProfile_Click" Tag="Work">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kerja &amp; Produktif" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="Auto-trim RAM &amp; mode hening" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Profile 3: Gaming -->
                        <RadioButton x:Name="RadioGaming" Grid.Column="4" Style="{StaticResource NavButton}" Height="54" Padding="12,8" Click="RadioProfile_Click" Tag="Gaming">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Gaming (Performa Maksimal)" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="Skema daya &amp; performa tinggi" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Grid>
            </Border>

            <!-- Metrics Grid: CPU, RAM, Storage -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Prosesor (CPU)" Style="{StaticResource CardTitleStyle}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource BrushAccentLight}" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="TxtCpuStatus" Text="Normal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtCpuPercent" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="3,0,0,4" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ProgressBar x:Name="ProgressCpu" Style="{StaticResource ModernProgressBar}" Value="0" Maximum="100" />
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="Aktivitas" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock Text="Beban total seluruh core" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Status" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock Text="Performa real-time" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Memori (RAM)" Style="{StaticResource CardTitleStyle}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource BrushSuccessLight}" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="TxtRamStatus" Text="Stabil" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtRamPercent" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="3,0,0,4" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ProgressBar x:Name="ProgressRam" Style="{StaticResource ModernProgressBar}" Value="0" Maximum="100" Foreground="{StaticResource BrushAccent}" />
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="Terpakai" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock x:Name="TxtRamDetails" Text="0 GB / 0 GB" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" FontWeight="Medium" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Tersedia" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock x:Name="TxtRamFree" Text="0 GB" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" FontWeight="Medium" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Storage Card -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Penyimpanan (C:)" Style="{StaticResource CardTitleStyle}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource BrushAccentLight}" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="TxtStorageStatus" Text="Aman" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtStoragePercent" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="3,0,0,4" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ProgressBar x:Name="ProgressStorage" Style="{StaticResource ModernProgressBar}" Value="0" Maximum="100" />
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="Terpakai" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock x:Name="TxtStorageDetails" Text="0 GB / 0 GB" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" FontWeight="Medium" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Kosong" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                <TextBlock x:Name="TxtStorageFree" Text="0 GB" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Right" FontWeight="Medium" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Overview Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Informasi Perangkat" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 1 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sistem Operasi" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoOs" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,12" />

                            <TextBlock Text="Nama Komputer" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoComputer" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Col 2 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Versi Build" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoBuild" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,12" />

                            <TextBlock Text="Pengguna Aktif" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoUser" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Col 3 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Arsitektur" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoArch" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,12" />

                            <TextBlock Text="Waktu Aktif (Uptime)" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="TxtInfoUptime" Text="-" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
