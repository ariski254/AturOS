<UserControl x:Class="AturOS.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kontrol Windows Update" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Atur perilaku pembaruan Windows sesuai preferensi Anda: hentikan sepenuhnya, jeda jangka panjang, atau batasi hanya patch keamanan."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRestoreDefault_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Kembalikan ke Default" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Options Grid -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <!-- Option 1: Hard Lockdown -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Stop Update Permanen (Hard Lockdown)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Mematikan dan mengunci service wuauserv, UsoSvc, Task Scheduler, dan menerapkan Registry NoAutoUpdate."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Height="34" Content="Terapkan Hard Lockdown" Click="BtnHardLockdown_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 2: Pause to 2099 -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Jeda Hingga Tahun 2099 (Pause to 2099)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Menyetel batas tanggal jeda update puluhan tahun ke depan via Registri tanpa mematikan dependensi Microsoft Store atau Xbox."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34" Content="Jeda ke 2099" Click="BtnPause2099_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 3: Security & Defender Only -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Hanya Patch Keamanan &amp; Defender" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Mengunci versi build Windows saat ini agar hanya menerima patch keamanan dan definisi virus tanpa unduhan Feature Update besar."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Content="Kunci Versi Build" Click="BtnSecurityOnly_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 4: Manual Notification Mode -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Mode Notifikasi Manual (AUOptions = 2)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Windows dilarang mengunduh update otomatis di latar belakang dan wajib meminta izin pengguna terlebih dahulu."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan Manual" Click="BtnManualMode_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 5: Block Automatic Driver Updates -->
                    <Border Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Blokir Pembaruan Driver Otomatis" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Mencegah Windows Update menimpa driver GPU, Audio, dan Chipset yang sudah stabil dengan versi generic dari Microsoft."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Blokir Driver" Margin="0,0,8,0" Click="BtnBlockDrivers_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Izinkan Driver" Click="BtnAllowDrivers_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
