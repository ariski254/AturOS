<UserControl x:Class="AturOS.Views.MemoryOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Optimasi RAM" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Kurangi working set memori proses yang menganggur secara aman tanpa mematikan aplikasi Anda."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Action: Optimize RAM & Standby List Buttons -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFlushStandby" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,2,8,2" Click="BtnFlushStandby_Click" ToolTip="Bersihkan cache Standby List Windows yang membebani game/aplikasi berat">
                        <TextBlock Text="Bersihkan Standby List" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnOptimizeRam" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,2,0,2" Click="BtnOptimizeRam_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconMemory}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Bebaskan RAM Sekarang" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- RAM Status Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Kapasitas RAM" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="TxtTotalRam" Text="0 GB" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="RAM Terpakai Saat Ini" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="TxtUsedRam" Text="0 GB (0%)" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="RAM Tersedia" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="TxtFreeRam" Text="0 GB" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Memory Tweaks Section -->
            <TextBlock Text="Kustomisasi &amp; Tweak Memori Windows" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Tweak 1: Disable Paging Executive -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kunci Kernel di RAM Fisik (Disable Paging Executive)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <Border x:Name="BadgePagingExec" Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgePagingExec" Text="Memeriksa..." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Cegah modul kernel Windows dan driver dialihkan ke pagefile disk, menjaga performa OS tetap responsif di RAM fisik." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan (Lock RAM)" Margin="0,2,8,2" Click="BtnPagingExecOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Default" Margin="0,2,0,2" Click="BtnPagingExecOff_Click" />
                        </WrapPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Tweak 2: Clear Pagefile at Shutdown -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bersihkan Pagefile saat Matikan PC (Clear Pagefile at Shutdown)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <Border x:Name="BadgeClearPagefile" Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeClearPagefile" Text="Memeriksa..." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hapus sisa memori virtual dari disk saat PC dimatikan untuk mencegah fragmentasi pagefile dan kebocoran residu memori." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan" Margin="0,2,8,2" Click="BtnClearPagefileOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Nonaktifkan" Margin="0,2,0,2" Click="BtnClearPagefileOff_Click" />
                        </WrapPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Tweak 3: Large System Cache -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Large System Cache (Optimasi Alokasi Cache I/O Memori)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <Border x:Name="BadgeLargeCache" Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeLargeCache" Text="Memeriksa..." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Perluas alokasi cache sistem file Windows di RAM untuk meningkatkan throughput transfer dan baca-tulis file intensif." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan" Margin="0,2,8,2" Click="BtnLargeCacheOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Default" Margin="0,2,0,2" Click="BtnLargeCacheOff_Click" />
                        </WrapPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Tweak 4: Memory Compression -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kompresi Memori Windows (Memory Compression)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <Border x:Name="BadgeCompression" Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeCompression" Text="Memeriksa..." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Matikan untuk PC gaming / RAM >= 16 GB agar menghemat siklus CPU; aktifkan pada PC spesifikasi rendah agar menghemat kapasitas RAM fisik." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan (Hemat RAM)" Margin="0,2,8,2" Click="BtnCompressionOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Matikan (Hemat CPU)" Margin="0,2,0,2" Click="BtnCompressionOff_Click" />
                        </WrapPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Tweak 5: SysMain / Superfetch -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Layanan SysMain (Superfetch)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <Border x:Name="BadgeSysMain" Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeSysMain" Text="Memeriksa..." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Layanan yang memuat data aplikasi ke RAM di latar belakang. Nonaktifkan jika sering mengalami lonjakan disk 100% atau pemakaian RAM berlebih." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Jalankan (Auto)" Margin="0,2,8,2" Click="BtnSysMainOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Nonaktifkan" Margin="0,2,0,2" Click="BtnSysMainOff_Click" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Top Consuming Processes Section -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Proses dengan Konsumsi Memori Terbesar" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <Button x:Name="BtnRefreshProcesses" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Click="BtnRefreshProcesses_Click">
                    <TextBlock Text="Segarkan" FontSize="12" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid x:Name="GridTopProcesses" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" Background="Transparent" BorderThickness="0" RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90" />
                        <DataGridTextColumn Header="Nama Proses" Binding="{Binding ProcessName}" Width="*" />
                        <DataGridTextColumn Header="Memori (Working Set)" Binding="{Binding FormattedMemory}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
