<UserControl x:Class="AturOS.Views.ExplorerTweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kustomisasi Shell &amp; File Explorer" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Sesuaikan perilaku Windows Explorer untuk alur kerja yang lebih praktis, bersih, dan leluasa."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRestartExplorer_Click">
                    <TextBlock Text="Restart Windows Explorer" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Tweaks Cards -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <!-- Item 1: Show File Extensions -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Tampilkan Ekstensi Nama File (.exe, .txt, .png)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Membantu Anda mengidentifikasi jenis file asli dan menghindari file malware yang menyamar."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Tampilkan" Margin="0,0,8,0" Click="BtnShowExt_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Sembunyikan" Click="BtnHideExt_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Item 2: Show Hidden Files -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Tampilkan File &amp; Folder Tersembunyi (Hidden Files)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Menampilkan folder konfigurasi seperti AppData dan file sistem tersembunyi di File Explorer."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Tampilkan" Margin="0,0,8,0" Click="BtnShowHidden_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Sembunyikan" Click="BtnHideHidden_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Item 3: Remove - Shortcut Suffix -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Hapus Kata '- Shortcut' / '- Pintasan' pada Icon Baru" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Saat membuat shortcut file di desktop, Windows tidak akan menambahkan akhiran teks '- Shortcut' yang mengganggu."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Hapus Akhiran" Margin="0,0,8,0" Click="BtnRemoveShortcut_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Standar" Click="BtnRestoreShortcut_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Item 4: Take Ownership Menu -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Menu Klik-Kanan 'Take Ownership'" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Tambahkan opsi klik-kanan untuk mengambil alih hak izin penuh (permission) file atau folder yang terkunci."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Pasang Menu" Margin="0,0,8,0" Click="BtnAddTakeOwnership_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Hapus Menu" Click="BtnRemoveTakeOwnership_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Item 5: Disable Security Warning -->
                    <Border Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Matikan Pop-up 'Open File - Security Warning'" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Menghilangkan dialog konfirmasi keamanan yang berulang saat membuka file .exe atau installer yang baru diunduh."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Matikan Pop-up" Margin="0,0,8,0" Click="BtnDisableWarning_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Aktifkan (Default)" Click="BtnEnableWarning_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
