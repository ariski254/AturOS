<UserControl x:Class="AturOS.Views.WindowsLiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="880">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Windows Lite Mode" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Pangkas beban sistem berjenjang dengan integrasi auto-debloat otomatis untuk membebaskan RAM secara signifikan."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Actions Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRestoreStore_Click" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGrid}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pulihkan Store" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRevert_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Kembali ke Standar (Revert)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Loading Card -->
            <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtProgress" Text="Menerapkan konfigurasi Lite Mode..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" />
                </StackPanel>
            </Border>

            <!-- 3 Tier Lite Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tier 1: Mode Light -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeSuccess}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="TINGKAT 1 • AMAN" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushSuccess}" />
                            </Border>
                            <TextBlock Text="Mode Light" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Aman &amp; harian (~400-700 MB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="✓ Hapus bloatware sponsor (TikTok, Spotify, Candy Crush, Disney+, game kasual)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan telemetri dasar (DiagTrack) &amp; ad tracking" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan widget berita &amp; saran iklan Start Menu" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Nonaktifkan Scheduled Tasks CEIP non-esensial" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Edge, Office, Store &amp; utilitas 100% utuh" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,6,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Terapkan Mode Light" Click="BtnApplyLevel1_Click" />
                    </Grid>
                </Border>

                <!-- Tier 2: Mode Medium -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeWarning}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="TINGKAT 2 • SEIMBANG" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushWarning}" />
                            </Border>
                            <TextBlock Text="Mode Medium" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Seimbang &amp; kerja (~1.2-2.0 GB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="✓ Seluruh pembersihan Tingkat 1 (Mode Light)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Hapus UWP sekunder (Weather, News, Maps, Tips, Feedback, Sticky Notes, Solitaire)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan integrasi Cortana &amp; Windows Copilot" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Hentikan SysMain (Superfetch) &amp; WSearch" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Blokir Background Apps secara global" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan efek transparansi &amp; animasi berlebih" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Terapkan Mode Medium" Click="BtnApplyLevel2_Click" />
                    </Grid>
                </Border>

                <!-- Tier 3: Mode Extreme -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeDanger}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="TINGKAT 3 • EKSTREM" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushDanger}" />
                            </Border>
                            <TextBlock Text="Mode Extreme" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="PC kentang / gaming (~2.5-3.5+ GB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="✓ Seluruh optimasi Tingkat 1 &amp; Tingkat 2" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Copot Microsoft Edge &amp; Edge Update tuntas" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Sisakan Explorer, Notepad, Calc, Snipping &amp; Photos" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Copot Xbox, Phone Link, Mail, Camera, Store" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Setel visual ke 'Adjust for Best Performance'" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Hapus hiberfil.sys &amp; aktifkan CompactOS" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Matikan Spooler, Bluetooth, RemoteRegistry" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                            <TextBlock Text="✓ Flush Working Set &amp; Standby List seketika" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,5" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource DangerButton}" Height="36" Content="Terapkan Mode Extreme" Click="BtnApplyLevel3_Click" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
