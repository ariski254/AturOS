<UserControl x:Class="AturOS.Views.WindowsLiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
              d:DesignHeight="1200" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- 1. Header & Quick Actions -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Profil Performa Windows" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Sistem 5-Profil performa Windows terintegrasi (Light, Balanced, Gaming, Extreme, Low-End) disesuaikan dengan kebutuhan dan spesifikasi hardware Anda."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Actions Header -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoRestore" Style="{StaticResource ModernCheckBox}" Content="Auto Restore Point"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,2,14,2"
                              ToolTip="Secara otomatis membuat System Restore Point sebelum menerapkan perubahan profil" />
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnReconcile_Click" Margin="0,2,8,2" ToolTip="Pindai dan bersihkan kembali aplikasi bloatware &amp; telemetri yang dipasang ulang oleh Windows Update">
                        <TextBlock Text="Rekonsiliasi Update" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRestoreStore_Click" Margin="0,2,8,2">
                        <TextBlock Text="Pulihkan Store" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRevert_Click" Margin="0,2,0,2">
                        <TextBlock Text="Kembali ke Standar" VerticalAlignment="Center" />
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- 2. Hardware Environment Card (Step 1: Scan & Multi-Factor Classification) -->
            <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Row 0: Badges & Summary -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hardware Tier Badge & Recommended Profile Badge -->
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border x:Name="BorderHwTier" Background="{StaticResource BrushAccentLight}" CornerRadius="8" Padding="10,6" Margin="0,2,8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRocket}" Fill="{StaticResource BrushAccent}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtHwTier" Text="TIER: MEMERIKSA..." FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BrushSuccessLight}" CornerRadius="8" Padding="10,6" Margin="0,2,8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHwRecommendation" Text="Rekomendasi: Mode Balanced" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                            </Border>
                        </WrapPanel>

                        <!-- Quick Apply Recommendation Button & Refresh -->
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnApplyRecommendedProfile" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,4" Margin="0,2,8,2" Content="Terapkan Rekomendasi Ini" Click="BtnApplyRecommendedProfile_Click" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="10,4" Margin="0,2,0,2" Content="Segarkan" Click="BtnRefreshHardware_Click" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Grid>

                    <!-- Row 1: Hardware Specs Matrix -->
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: CPU -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                                <TextBlock Text="PROSESOR (CPU)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtHwCpu" Text="Mendeteksi..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Col 1: RAM -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,6">
                                <TextBlock Text="MEMORI FISIK (RAM)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtHwRam" Text="Mendeteksi..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Col 2: GPU -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,6">
                                <TextBlock Text="GRAFIS (GPU)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtHwGpu" Text="Mendeteksi..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Col 3: Storage -->
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,6">
                                <TextBlock Text="PENYIMPANAN SISTEM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtHwStorage" Text="Mendeteksi..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Row 2 extra: Power, Device, Bluetooth -->
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                <TextBlock x:Name="TxtHwDeviceType" Text="Tipe: -" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0" />
                                <TextBlock x:Name="TxtHwPowerSource" Text="Daya: -" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0" />
                                <TextBlock x:Name="TxtHwBluetooth" Text="Bluetooth: -" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0" />
                                <TextBlock x:Name="TxtHwReasonsSummary" Text="Alasan: -" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextBody}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Laptop Battery Warning Alert (Only visible if on laptop and battery) -->
                    <Border Grid.Row="2" x:Name="HwBatteryWarningBox" Background="{StaticResource BrushWarningLight}" BorderBrush="{StaticResource BrushWarning}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtHwBatteryWarning" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Loading Progress Card (Step 4: Apply) -->
            <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtProgress" Text="Menerapkan konfigurasi Lite Mode..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" />
                </StackPanel>
            </Border>

            <!-- 3. Dry-Run Preview Modal/Card (Step 3: Preview) -->
            <Border x:Name="PreviewCard" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1.5" CornerRadius="12" Padding="24" Margin="0,0,0,24" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtPreviewTitle" Text="DRY-RUN PREVIEW PROFIL" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                            <TextBlock x:Name="TxtPreviewSubtitle" Text="Rincian perubahan konfigurasi sistem sebelum diterapkan." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="BadgePreviewType" Style="{StaticResource BadgeAccent}" VerticalAlignment="Top">
                            <TextBlock x:Name="TxtPreviewRam" Text="~2.0 - 3.0 GB RAM Bebas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                    </Grid>

                    <!-- Itemized Specs Grid -->
                    <Border Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1 -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Aplikasi yang akan dicopot:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewApps" Text="34 Paket" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Layanan yang dimodifikasi:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewServices" Text="10 Service" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Scheduled Tasks dinonaktifkan:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewTasks" Text="22 Tasks" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Registry &amp; Policy Tweaks:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewTweaks" Text="18 Tweaks" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Kebijakan Windows Update:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewUpdate" Text="ON (Standar)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Column 2 -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Target Skema Daya (Power):" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewPower" Text="Ultimate Performance" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Windows Game Mode:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewGameMode" Text="ON (DVR Off)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Profil Visual &amp; Efek:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewVisual" Text="Performance" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Status Hibernasi Sistem:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtPreviewHibernation" Text="Keep (Biarkan)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Antivirus Defender &amp; Firewall:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="SELALU AKTIF (AMAN)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Highlights List -->
                    <TextBlock Text="Rincian Tindakan Profil:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ItemsPreviewHighlights" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="•" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Extreme Warning Box -->
                    <Border x:Name="PreviewWarningBox" Background="{StaticResource BrushDangerLight}" BorderBrush="{StaticResource BrushDanger}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="PERINGATAN PROFIL EXTREME GAMING" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrushDanger}" Margin="0,0,0,6" />
                            <TextBlock x:Name="TxtPreviewWarning" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Hardware Notice Box -->
                    <Border x:Name="PreviewHwNoticeBox" Background="{StaticResource BrushWarningLight}" BorderBrush="{StaticResource BrushWarning}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="TxtPreviewHwNotice" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Preview Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Height="38" Content="Batalkan (Tutup Preview)" Click="BtnCancelPreview_Click" HorizontalAlignment="Left" />
                        
                        <Button Grid.Column="1" x:Name="BtnConfirmApply" Style="{StaticResource PrimaryButton}" Height="38" Padding="20,8"
                                Content="Terapkan Profil Sekarang" Click="BtnConfirmApply_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Post-Apply Verification Results Card (Step 5: Verify) -->
            <Border x:Name="VerificationCard" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hasil Verifikasi Sub-Sistem Windows" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Audit langsung ke registri dan sistem Windows untuk memastikan perubahan benar-benar diterapkan."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32" Content="Tutup Hasil" Click="BtnCloseVerification_Click" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Verification Items List -->
                    <ItemsControl x:Name="ItemsVerification">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" MinWidth="140" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                        
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Target: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding Expected}" FontSize="12" Foreground="{StaticResource BrushTextBody}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Aktual: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding Actual}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                        </WrapPanel>

                                        <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Restart Advisory Note -->
                    <Border Background="{StaticResource BrushAccentLight}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Beberapa perubahan sistem (seperti prioritas CPU dan Explorer) optimal setelah restart komputer."
                                           FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="30" Content="Restart Sekarang" Click="BtnRestartNow_Click" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Four Profile Cards (2x2 Grid) -->
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Profile 1: Light Mode -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeSuccess}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="PROFIL 1 • AMAN &amp; HARIAN" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushSuccess}" />
                            </Border>
                            <TextBlock Text="Mode Light" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Aman, stabil &amp; harian (~500 - 800 MB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="✓ Hapus bloatware sponsor &amp; game kasual pihak ketiga (TikTok, Spotify, Candy Crush)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan telemetri dasar (DiagTrack) &amp; pelacakan iklan pengguna" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan saran iklan dan rekomendasi pada Start Menu" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Nonaktifkan Scheduled Tasks diagnostik non-esensial" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Microsoft Edge, Store, Office, dan Update tetap 100% utuh" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Preview &amp; Terapkan Light" Click="BtnPreviewLight_Click" />
                    </Grid>
                </Border>

                <!-- Profile 2: Balanced Mode -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeWarning}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="PROFIL 2 • SEIMBANG &amp; KERJA" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushWarning}" />
                            </Border>
                            <TextBlock Text="Mode Balanced" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Kerja, multitasking &amp; editing (~1.2 - 2.0 GB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="✓ Seluruh pembersihan dan keamanan Profil 1 (Light Mode)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Hapus UWP sekunder (Weather, Maps, News, Tips, Feedback, Sticky Notes)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan integrasi Copilot dan Widgets taskbar" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Hentikan SysMain (Superfetch) dan batasi Background Apps global" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Store, Windows Update, dan Defender tetap 100% aktif" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Preview &amp; Terapkan Balanced" Click="BtnPreviewBalanced_Click" />
                    </Grid>
                </Border>

                <!-- Profile 3: Gaming Mode -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeAccent}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="PROFIL 3 • GAMING &amp; LOW LATENCY" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                            <TextBlock Text="Mode Gaming" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="FPS, latensi rendah &amp; HAGS (~2.0 - 3.0 GB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="✓ Aktifkan Ultimate Performance &amp; matikan Core Parking (100% core aktif)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Setel Win32PrioritySeparation = 38 untuk responsivitas game latar depan" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Aktifkan HAGS &amp; optimasi Game Mode Windows (GameDVR Nonaktif)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan algoritma Nagle (TCPNoDelay) &amp; akselerasi mouse 1:1" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Store &amp; Defender tetap aktif agar aman untuk game online" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Preview &amp; Terapkan Gaming" Click="BtnPreviewGaming_Click" />
                    </Grid>
                </Border>

                <!-- Profile 4: Extreme Gaming Mode -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeDanger}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="PROFIL 4 • EKSTREM &amp; PANGKAS TOTAL" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushDanger}" />
                            </Border>
                            <TextBlock Text="Mode Extreme Gaming" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="PC gaming murni / kentang (~3.0 - 4.5+ GB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="✓ Kunci Windows Update (Lockdown Policy) cegah download saat game berlangsung" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Copot Microsoft Edge &amp; OneDrive bawaan sistem hingga tuntas" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Matikan service Print Spooler, WSearch, SysMain &amp; nonaktifkan hibernasi" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Aktifkan kompresi sistem CompactOS &amp; flush Working Set RAM seketika" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Defender &amp; Firewall TETAP AKTIF demi keamanan saat main game" FontSize="11" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource DangerButton}" Height="36" Content="Preview &amp; Terapkan Extreme" Click="BtnPreviewExtreme_Click" />
                    </Grid>
                </Border>

                <!-- Profile 5: Low-End / Potato Mode (Mode Kentang) -->
                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="PROFIL 5 • MODE KENTANG / LOW-END" FontWeight="Bold" FontSize="10.5" Foreground="#B45309" />
                            </Border>
                            <TextBlock Text="Mode Low-End / Kentang" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="PC terbatas, RAM ≤4GB, HDD/eMMC (~1.5 - 3.5 GB)" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="✓ Dirancang khusus untuk PC spek terbatas (Dual-core/Celeron, RAM ≤4GB, HDD/eMMC)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Setel Visual Effects ke Best Performance (matikan animasi, bayangan, transparansi)" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Optimasi Disk I/O: matikan Windows Search indexer &amp; atur beban kerja SysMain" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="✓ Aktifkan kompresi sistem CompactOS &amp; optimasi alokasi Pagefile virtual memory" FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="• Windows Defender &amp; Store tetap aktif agar PC aman dan dapat instal aplikasi" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="36" Content="Preview &amp; Terapkan Low-End" Click="BtnPreviewLowEnd_Click" />
                    </Grid>
                </Border>

                <!-- Recommendation Card -->
                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource BadgeAccent}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="SMART ENGINE • REKOMENDASI PERANGKAT" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                            <TextBlock Text="Pilihan Profil Otomatis" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Dianalisis dari RAM, CPU, GPU &amp; Penyimpanan sistem" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,14" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="Engine cerdas AturOS menganalisis arsitektur sistem operasi, kapasitas RAM, jumlah core prosesor, ketersediaan GPU terdedikasi, serta jenis drive (SSD vs HDD) untuk menentukan profil paling pas." FontSize="12" Foreground="{StaticResource BrushTextBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="• Mencegah sistem crash atau bottleneck akibat setelan yang tidak sesuai kemampuan hardware." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="• Anda selalu dapat melihat rincian perubahan (dry-run) sebelum menerapkan ke sistem." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource AccentButton}" Height="36" Content="Terapkan Profil yang Direkomendasikan" Click="BtnApplyRecommendedProfile_Click" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
