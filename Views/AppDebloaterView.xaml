<UserControl x:Class="AturOS.Views.AppDebloaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Uninstaller Aplikasi &amp; Debloater Sistem" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Uninstall permanen aplikasi desktop (Win32) dan aplikasi sistem Windows (UWP) hingga ke akar-akarnya tanpa sisa berkas, proses, service, scheduled task, atau registri."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Click="BtnRefresh_Click">
                    <TextBlock Text="Pindai Ulang" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Search and Filter Bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Full-Width Search Box -->
                    <Grid Grid.Row="0">
                        <TextBox x:Name="TxtSearch" Height="36" VerticalContentAlignment="Center" Padding="34,0,12,0"
                                 BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}"
                                 Foreground="{StaticResource BrushTextPrimary}" FontSize="13"
                                 TextChanged="TxtSearch_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="Cari aplikasi, penerbit, atau nama paket..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="36,0,0,0"
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12.5"/>
                    </Grid>

                    <!-- Row 1: Filter Combo & Safe Only Checkbox -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Category Filter Combo -->
                        <ComboBox x:Name="ComboCategory" Grid.Column="0" Height="36" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Padding="10,0" VerticalContentAlignment="Center"
                                  SelectionChanged="ComboCategory_SelectionChanged">
                            <ComboBoxItem Content="Semua Aplikasi (Sistem &amp; Terinstall)" IsSelected="True" />
                            <ComboBoxItem Content="Hanya Aplikasi Sistem Windows" />
                            <ComboBoxItem Content="Hanya Aplikasi Pengguna" />
                            <ComboBoxItem Content="Aplikasi Desktop (Win32)" />
                            <ComboBoxItem Content="Aplikasi Modern (UWP / Store)" />
                            <ComboBoxItem Content="Gaming &amp; Hiburan" />
                        </ComboBox>

                        <!-- Safe Only CheckBox -->
                        <CheckBox x:Name="CheckSafeOnly" Grid.Column="1" Content="Hanya yang Aman Dihapus" VerticalAlignment="Center"
                                  Checked="CheckSafeOnly_Changed" Unchecked="CheckSafeOnly_Changed" Style="{StaticResource ModernCheckBox}" />
                    </Grid>

                    <!-- Row 2: Summary / Counter Bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtAppCount" Text="Memuat seluruh aplikasi sistem &amp; terinstall..." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <ProgressBar x:Name="ProgressScanning" Grid.Column="1" Width="140" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Catalog Items -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ItemsControl x:Name="ListAppCatalog">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>                                    <!-- Details -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                         <WrapPanel VerticalAlignment="Center">
                                             <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,4" VerticalAlignment="Center" />
                                             
                                             <!-- Origin Badge: Sistem Windows vs Aplikasi Pengguna -->
                                             <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Background" Value="#F1F5F9" />
                                                         <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                         <Setter Property="BorderThickness" Value="1" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSystemApp}" Value="True">
                                                                 <Setter Property="Background" Value="#FEF3C7" />
                                                                 <Setter Property="BorderBrush" Value="#FDE68A" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <TextBlock Text="{Binding OriginBadgeText}" FontSize="10" FontWeight="SemiBold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsSystemApp}" Value="True">
                                                                     <Setter Property="Foreground" Value="#B45309" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Border>

                                             <!-- App Type Badge (Win32 vs UWP) -->
                                             <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Background" Value="#EFF6FF" />
                                                         <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                         <Setter Property="BorderThickness" Value="1" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding AppTypeDisplay}" Value="Win32 Desktop">
                                                                 <Setter Property="Background" Value="#F8FAFC" />
                                                                 <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <TextBlock Text="{Binding AppTypeDisplay}" FontSize="10" FontWeight="SemiBold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding AppTypeDisplay}" Value="Win32 Desktop">
                                                                     <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Border>

                                             <!-- Category Badge -->
                                             <Border Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                                             </Border>

                                             <!-- Safety Badge -->
                                             <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Background" Value="{StaticResource BrushSuccessLight}" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSafeToRemove}" Value="False">
                                                                 <Setter Property="Background" Value="{StaticResource BrushWarningLight}" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <TextBlock FontSize="10" FontWeight="SemiBold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Text" Value="Aman Dihapus" />
                                                             <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsSafeToRemove}" Value="False">
                                                                     <Setter Property="Text" Value="Disarankan Tetap Ada" />
                                                                     <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Border>

                                             <!-- Non-Removable Protection Badge -->
                                             <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsNonRemovable}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible" />
                                                                 <Setter Property="Background" Value="#FEE2E2" />
                                                                 <Setter Property="BorderBrush" Value="#FECACA" />
                                                                 <Setter Property="BorderThickness" Value="1" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <TextBlock Text="Diproteksi Windows" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626" />
                                             </Border>
                                        </WrapPanel>

                                        <!-- Publisher & Version details -->
                                        <TextBlock Text="{Binding FormattedDetails}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                        <!-- Package Name / Identifier -->
                                        <TextBlock Text="{Binding PackageName}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,16,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccessLight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Actions: Single Unified Permanent Uninstall + Store or Open Folder -->
                                    <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Uninstall" Style="{StaticResource DangerButton}" Height="32" Padding="14,0" FontSize="12"
                                                IsEnabled="{Binding IsInstalled}" Click="BtnUninstall_Click" Tag="{Binding}" Margin="0,2,6,2"
                                                ToolTip="Uninstall aplikasi secara permanen hingga ke akar-akarnya (proses, service, task, registry, dan residu berkas)" />
                                        <Button Content="{Binding ActionSecondaryText}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" FontSize="12"
                                                IsEnabled="{Binding CanActionSecondary}" Click="BtnReinstallStore_Click" Tag="{Binding}" Margin="0,2,0,2" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
