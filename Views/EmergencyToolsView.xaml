<UserControl x:Class="AturOS.Views.EmergencyToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Alat Darurat &amp; Pemeliharaan Hardware" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Utilitas tanggap darurat saat sistem hang, troubleshooting integritas berkas Windows, dan diagnosa baterai laptop."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Loading Progress -->
            <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtProgress" Text="Menjalankan operasi sistem..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" />
                </StackPanel>
            </Border>

            <!-- Section 1: Quick Emergency Actions -->
            <TextBlock Text="Aksi Pemulihan Cepat" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Kill Frozen Apps -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Tutup Paksa Aplikasi Membeku (Kill Not-Responding Tasks)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Menutup seketika semua jendela dan program yang sedang mengalami freeze/hang tanpa perlu mencari di Task Manager." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Height="34" Content="Tutup Aplikasi Macet" Click="BtnKillFrozen_Click" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Restart Explorer -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Restart Windows Explorer (1-Klik)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Memulai ulang shell Windows untuk mengatasi taskbar macet, start menu tidak merespon, atau icon desktop hilang." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Content="Restart Explorer" Click="BtnRestartExplorer_Click" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Clear Clipboard -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Bersihkan Riwayat Clipboard Sistem" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Hapus riwayat salinan teks, sandi, dan gambar dari buffer clipboard Windows untuk menjaga privasi." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Content="Bersihkan Clipboard" Click="BtnClearClipboard_Click" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Laptop & Hardware Maintenance -->
            <TextBlock Text="Pengaturan Laptop &amp; Boot" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Battery Report -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Laporan Kesehatan Baterai Laptop (Battery Report)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Hasilkan laporan detail kesehatan baterai, kapasitas desain vs penuh, dan riwayat pemakaian dalam format HTML." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34" Content="Buat Laporan Baterai" Click="BtnBatteryReport_Click" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Lid Close Action -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Aksi Tutup Layar Laptop (Lid Close Action)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Tentukan apa yang terjadi saat layar laptop Anda ditutup: tetap menyala (Do Nothing), Sleep, atau Shutdown." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="ComboLidAction" Width="190" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0">
                                <ComboBoxItem Content="Tidak Melakukan Apa-apa" IsSelected="True" Tag="0" />
                                <ComboBoxItem Content="Tidur (Sleep)" Tag="1" />
                                <ComboBoxItem Content="Hibernasi" Tag="2" />
                                <ComboBoxItem Content="Matikan (Shutdown)" Tag="3" />
                            </ComboBox>
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Simpan" Click="BtnSaveLidAction_Click" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                    <!-- Safe Mode Shortcut -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Pintasan Boot ke Safe Mode (bcdedit)" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Setel Windows agar langsung masuk ke Safe Mode pada proses restart berikutnya untuk troubleshooting driver." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource DangerButton}" Height="34" Content="Masuk Safe Mode" Margin="0,0,8,0" Click="BtnSafeModeOn_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Boot Normal" Click="BtnSafeModeOff_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: System File Integrity (SFC & DISM) -->
            <TextBlock Text="Pemeriksaan Integritas Sistem (SFC &amp; DISM)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="SFC Scannow (System File Checker)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Pindai seluruh file sistem Windows dan perbaiki otomatis file yang hilang atau korup."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,16" />
                            <Button Style="{StaticResource PrimaryButton}" Height="34" Content="Jalankan SFC Scannow" Click="BtnRunSfc_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="DISM Restore Health" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Perbaiki komponen citra Windows yang rusak menggunakan sumber data Windows Update resmi."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,16" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Jalankan DISM Restore" Click="BtnRunDism_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
