<UserControl x:Class="AturOS.Views.SystemDoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="850"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Title & Header Banner -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dokter Sistem &amp; Auto-Repair" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Diagnosa menyeluruh, perbaikan berkas rusak SFC/DISM, jaringan, update, dan pustaka runtime DLL." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnRefreshStatus" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Click="BtnRefreshStatus_Click" VerticalAlignment="Center">
                    <TextBlock Text="Segarkan Status" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Status Notification Banner (if any) -->
            <Border x:Name="BannerStatus" Visibility="Collapsed" Background="{StaticResource BrushInfoLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconInfo}" Fill="{StaticResource BrushAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="TxtBannerMessage" Grid.Column="1" Text="Status" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Section 1: Integritas Berkas Sistem (SFC + DISM) & Troubleshooter Update (2 Columns) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: SFC & DISM -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Integritas Berkas Sistem (SFC &amp; DISM)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Memeriksa kerusakan berkas dengan sfc /scannow. Jika ada kerusakan yang gagal diperbaiki, otomatis menjalankan DISM RestoreHealth."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Perlindungan Komponen Windows" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock x:Name="TxtSfcStatus" Text="Siap untuk pemindaian" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2" x:Name="BtnRunSfcDism" Style="{StaticResource PrimaryButton}" Height="36" Content="Pindai &amp; Perbaiki Berkas" Click="BtnRunSfcDism_Click" />
                    </Grid>
                </Border>

                <!-- Card 2: Windows Update Queue Troubleshooter -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Perbaikan Antrian Windows Update" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Mengatasi Windows Update macet atau gagal unduh. Menghentikan servis terkait, mereset SoftwareDistribution dan Catroot2, lalu menyalakan kembali layanan."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Target Pembersihan" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="SoftwareDistribution &amp; Catroot2" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2" x:Name="BtnResetUpdateQueue" Style="{StaticResource SecondaryButton}" Height="36" Content="Reset Antrian Update (1-Klik)" Click="BtnResetUpdateQueue_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Section 2: Network Stack & Disk Health (2 Columns) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 3: Network Stack Repair -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Perbaikan Jaringan &amp; TCP/IP Stack" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Mereset katalog Winsock, konfigurasi TCP/IP stack, membersihkan cache DNS, serta me-renew lease IP untuk mengatasi gangguan koneksi internet."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Operasi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="Winsock Reset • TCP/IP Reset • DNS Flush" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2" x:Name="BtnRepairNetwork" Style="{StaticResource SecondaryButton}" Height="36" Content="Reset Tumpukan Jaringan" Click="BtnRepairNetwork_Click" />
                    </Grid>
                </Border>

                <!-- Card 4: Disk Health & CHKDSK -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Integritas Drive Sistem (C:)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Mengecek status kesehatan drive sistem dan dirty bit. Menjadwalkan pemindaian bad sector dan error partisi saat sistem dinyalakan ulang."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Status Drive C:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock x:Name="TxtDiskStatus" Text="Memuat status..." FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border x:Name="BadgeDiskDirty" Grid.Column="1" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeDisk" Text="Normal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Button Grid.Row="2" x:Name="BtnScheduleChkdsk" Style="{StaticResource SecondaryButton}" Height="36" Content="Jadwalkan CHKDSK saat Restart" Click="BtnScheduleChkdsk_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Section 3: Runtime Dependency Validator (VC++, DirectX, .NET) -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Validasi Pustaka Runtime (.DLL Missing)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Deteksi ketiadaan dependensi Visual C++, DirectX, dan .NET Runtime untuk mencegah crash 'MSVCP140.dll / d3dx9 not found'." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnScanRuntimes" Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" Click="BtnScanRuntimes_Click" VerticalAlignment="Center">
                            <TextBlock Text="Pindai Dependensi" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- Runtime Items ItemsControl -->
                    <ItemsControl x:Name="ListRuntimes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" Margin="12,0" VerticalAlignment="Center"
                                                Background="{Binding StatusBadgeBg}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeColor}" />
                                        </Border>

                                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="32" Padding="14,0" VerticalAlignment="Center"
                                                Tag="{Binding WingetId}" Click="BtnInstallRuntimeItem_Click"
                                                IsEnabled="{Binding IsInstalled, Converter={x:Null}}">
                                            <TextBlock Text="Pasang (Winget)" FontSize="11.5" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Section 4: Broken Shortcuts & Orphaned Registry -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Pembersih Jalan Pintas Rusak (.lnk) &amp; Orphaned Registry" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Mendeteksi jalan pintas di Desktop/Start Menu yang targetnya sudah hilang dan entri registri uninstall bekas aplikasi." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnScanShortcutsRegistry" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,2,8,2" Click="BtnScanShortcutsRegistry_Click">
                                <TextBlock Text="Pindai Masalah" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="BtnCleanShortcutsRegistry" Style="{StaticResource DangerButton}" Height="34" Padding="12,0" IsEnabled="False" Margin="0,2,0,2" Click="BtnCleanShortcutsRegistry_Click">
                                <TextBlock Text="Bersihkan Terpilih" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <TextBlock x:Name="TxtShortcutsSummary" Text="Belum dipindai. Tekan 'Pindai Masalah' untuk mencari berkas shortcut rusak dan entri orphaned." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />

                    <!-- Scanned Items List -->
                    <ListBox x:Name="ListShortcuts" MaxHeight="140" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,4" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="4,2" Style="{StaticResource ModernCheckBox}">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding BrokenTarget, StringFormat='-> {0}'}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                                    </WrapPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Operation Activity Log Panel -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Log Aktivitas &amp; Diagnosa Sistem" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearLog" Style="{StaticResource OutlineButton}" Height="30" Padding="12,0" Margin="0,0,8,0" Click="BtnClearLog_Click">
                                <TextBlock Text="Bersihkan Log" FontSize="11.5" />
                            </Button>
                            <ProgressBar x:Name="ProgressOperation" IsIndeterminate="False" Width="100" Height="6" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" Style="{StaticResource ModernProgressBar}" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="TxtConsoleLog" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" Background="{StaticResource BrushBackground}"
                             BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12" Foreground="{StaticResource BrushTextPrimary}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
