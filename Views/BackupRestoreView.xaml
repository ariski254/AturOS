<UserControl x:Class="AturOS.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Backup &amp; Restore" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Buat titik pemulihan sistem (System Restore Point) sebelum menerapkan perubahan penting pada sistem Windows Anda."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Header Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnOpenRestoreWizard_Click" Margin="0,0,10,0">
                        <TextBlock Text="Buka Wizard Pemulihan (rstrui)" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnOpenSystemProtection_Click">
                        <TextBlock Text="Properti Sistem" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Admin Notice Banner if running as Standard User -->
            <Border x:Name="AdminNoticeCard" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Jalankan Ulang Sebagai Administrator" Style="{StaticResource PrimaryButton}" Height="32" FontSize="12" Padding="12,0" Click="BtnRestartAdmin_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hak Akses Administrator Diperlukan untuk Membaca Daftar Restore Point" FontWeight="SemiBold" FontSize="13" Foreground="#92400E" />
                        <TextBlock Text="Windows membatasi pembacaan titik pemulihan sistem jika aplikasi berjalan sebagai pengguna standar." FontSize="11.5" Foreground="#78350F" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Create Restore Point Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Buat System Restore Point Baru" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="Simpan kondisi file sistem, registry, dan driver saat ini agar dapat dipulihkan kapan saja jika terjadi masalah."
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Input Description -->
                        <TextBox x:Name="TxtDescription" Text="AturOS-Backup" Height="36" VerticalContentAlignment="Center" Padding="12,0"
                                 BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}"
                                 Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,12,0">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Create Button -->
                        <Button x:Name="BtnCreatePoint" Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="36" Click="BtnCreatePoint_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Buat Restore Point" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Loading bar during creation -->
                    <StackPanel x:Name="CreationProgress" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="Membuat titik pemulihan sistem melalui Windows Checkpoint-Computer (bisa memakan waktu 10-30 detik)..."
                                   FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6" />
                        <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Existing Restore Points List -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Daftar Titik Pemulihan Tersedia" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <Button x:Name="BtnRefreshList" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="BtnRefreshList_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Segarkan" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,24">
                <StackPanel>
                    <DataGrid x:Name="GridRestorePoints" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" Background="Transparent" BorderThickness="0" RowHeight="44">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding SequenceNumber}" Width="70" />
                            <DataGridTextColumn Header="Deskripsi" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Waktu Pembuatan" Binding="{Binding CreationTime}" Width="200" />
                            <DataGridTextColumn Header="Tipe Event" Binding="{Binding EventType}" Width="130" />
                            <DataGridTemplateColumn Header="Aksi Pemulihan" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Pulihkan Sistem" Style="{StaticResource PrimaryButton}" Height="28" Padding="10,0" FontSize="11" Click="BtnRestoreSystemPoint_Click" Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtEmptyRestorePoints" Text="Belum ada titik pemulihan sistem yang tersimpan (atau jalankan sebagai Administrator untuk membaca daftar sistem)."
                               Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Registry Backup Card -->
            <TextBlock Text="Cadangan &amp; Pemulihan Registri (.reg)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ekspor nilai konfigurasi registry Windows saat ini ke file .reg agar dapat dipulihkan kapan saja secara instan."
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboRegistryKey" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0" Padding="10,0">
                            <ComboBoxItem Content="HKCU\Software\Policies (Kebijakan Pengguna)" IsSelected="True" Tag="HKEY_CURRENT_USER\Software\Policies" />
                            <ComboBoxItem Content="HKLM\SOFTWARE\Policies (Kebijakan Mesin)" Tag="HKEY_LOCAL_MACHINE\SOFTWARE\Policies" />
                            <ComboBoxItem Content="HKCU\Control Panel (Pengaturan Tampilan &amp; Input)" Tag="HKEY_CURRENT_USER\Control Panel" />
                            <ComboBoxItem Content="HKLM\SYSTEM\CurrentControlSet\Services (Layanan Sistem)" Tag="HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services" />
                        </ComboBox>
                        <Button Style="{StaticResource PrimaryButton}" Height="36" Content="Ekspor Cadangan .reg" Click="BtnBackupRegistry_Click" Grid.Column="1" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Click="BtnOpenFolder_Click" Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Buka Folder Cadangan" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stored Registry Backups Table -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Margin="16,14">
                        <TextBlock Text="Berkas Cadangan Registri (.reg) Tersimpan" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Click="BtnRefreshRegBackups_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Segarkan Berkas" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid x:Name="GridRegistryBackups" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" Background="Transparent" BorderThickness="0" RowHeight="44">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Berkas" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Tanggal Dibuat" Binding="{Binding FormattedDate}" Width="180" />
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedSize}" Width="90" />
                            <DataGridTemplateColumn Header="Aksi Berkas" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Pulihkan" Style="{StaticResource PrimaryButton}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0" Click="BtnRestoreReg_Click" Tag="{Binding}" />
                                            <Button Content="Notepad" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" FontSize="11" Margin="0,0,6,0" Click="BtnOpenNotepad_Click" Tag="{Binding}" />
                                            <Button Content="Hapus" Style="{StaticResource DangerButton}" Height="28" Padding="8,0" FontSize="11" Click="BtnDeleteReg_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtEmptyRegistryBackups" Text="Belum ada berkas cadangan .reg yang tersimpan. Gunakan 'Ekspor Cadangan .reg' di atas."
                               Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
