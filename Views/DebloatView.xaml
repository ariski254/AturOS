<UserControl x:Class="AturOS.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Debloat &amp; Kustomisasi" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Sesuaikan konfigurasi Windows, nonaktifkan telemetri &amp; bloatware, dan kembalikan fitur klasik yang efisien."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Explorer Restart & Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshTweaks" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,10,0" Click="BtnRefreshTweaks_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Segarkan Status" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRestartExplorer" Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRestartExplorer_Click"
                            ToolTip="Terapkan perubahan UI seperti Menu Konteks tanpa restart PC">
                        <TextBlock Text="Restart Explorer" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Background="{StaticResource BrushSuccessLight}" BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBanner" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            Cursor="Hand" FontWeight="Bold" Padding="6,2" Click="BtnCloseBanner_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Tweaks List -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ItemsControl x:Name="ListTweaks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource BrushTextPrimary}" />
                                            <Border Background="{StaticResource BrushBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0"
                                                   Visibility="{Binding StatusMessage, Converter={x:Null}}" />
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,16,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccessLight}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="TidakDidukung">
                                                        <Setter Property="Background" Value="{StaticResource BrushWarningLight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="TidakDidukung">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Action Buttons: Terapkan / Pulihkan -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Terapkan" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" FontSize="12" Margin="0,0,8,0"
                                                IsEnabled="{Binding CanApply}" Click="BtnApplyTweak_Click" Tag="{Binding}" />
                                        <Button Content="Pulihkan" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" FontSize="12"
                                                IsEnabled="{Binding CanRestore}" Click="BtnRestoreTweak_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
