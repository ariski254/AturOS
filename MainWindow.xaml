<Window x:Class="AturOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AturOS - Windows Utility &amp; Optimization"
        Icon="Resources/app.ico"
        Height="720" Width="1100" MinHeight="620" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar (250px) -->
            <ColumnDefinition Width="250" />
            <!-- Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <!-- App Brand / Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- OS Status Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header / Logo -->
                <StackPanel Grid.Row="0" Margin="4,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Resources/app_badge.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AturOS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Utilitas Sistem Windows" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List (Scrollable for compact screens) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-6,0,-6,12">
                    <StackPanel Margin="6,0,6,0">
                        <!-- 1. Ringkasan -->
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Ringkasan" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Mode Windows Lite -->
                        <RadioButton x:Name="NavLite" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Lite">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRocket}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Mode Windows Lite" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Granular App Debloater -->
                        <RadioButton x:Name="NavDebloater" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Debloater">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconApps}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="App Debloater" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Pembersih Drive -->
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Cleaner">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCleaner}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Pembersih Drive" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Tuning Hardware & Gaming -->
                        <RadioButton x:Name="NavHardware" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Hardware">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGamepad}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Tuning &amp; Gaming" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 6. Optimasi RAM -->
                        <RadioButton x:Name="NavMemory" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Memory">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMemory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Optimasi RAM" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 7. Kontrol Windows Update -->
                        <RadioButton x:Name="NavUpdate" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Update">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUpdate}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Windows Update" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 8. Dokter Sistem & Auto-Repair -->
                        <RadioButton x:Name="NavDoctor" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Doctor">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDoctor}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Dokter Sistem" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 8. Pengoptimal Jaringan & DNS -->
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Network">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconNetwork}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Jaringan &amp; DNS" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 9. Kustomisasi Shell & Explorer -->
                        <RadioButton x:Name="NavExplorer" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Explorer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Kustomisasi Explorer" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 10. Pemasang Aplikasi Massal -->
                        <RadioButton x:Name="NavWinget" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Winget">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Pemasang Aplikasi" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 11. Alat Darurat & Hardware -->
                        <RadioButton x:Name="NavEmergency" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Emergency">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconEmergency}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Alat Darurat" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 12. Backup & Restore -->
                        <RadioButton x:Name="NavBackup" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Backup">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconShield}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Backup &amp; Restore" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- OS Status Footer -->
                <Border Grid.Row="2" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <!-- OS Name & Build -->
                        <TextBlock x:Name="TxtFooterOs" Text="Windows" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Name="TxtFooterBuild" Text="Build -" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,8" />

                        <!-- Admin Badge & Action -->
                        <Grid>
                            <Border x:Name="BadgeAdmin" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{StaticResource BrushSuccessLight}">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconAdminPath" Data="{StaticResource IconShield}" Fill="{StaticResource BrushSuccess}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock x:Name="TxtFooterAdmin" Text="Administrator" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                                </StackPanel>
                            </Border>

                            <!-- Button to Elevate if not admin -->
                            <Button x:Name="BtnElevate" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource BrushAccent}" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand"
                                    Content="Jalankan Admin" Visibility="Collapsed" Click="BtnElevate_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area with Top Header Bar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Global Search Bar -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6" Height="34" MaxWidth="380" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtGlobalSearch" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                                     VerticalAlignment="Center"
                                     GotFocus="TxtGlobalSearch_GotFocus"
                                     LostFocus="TxtGlobalSearch_LostFocus"
                                     TextChanged="TxtGlobalSearch_TextChanged"
                                     KeyDown="TxtGlobalSearch_KeyDown" />
                            <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Cari fitur, tweak, atau optimasi... (tekan Enter)"
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Quick Emergency Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Restart Explorer -->
                        <Button x:Name="BtnHeaderRestartExplorer" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="BtnHeaderRestartExplorer_Click" ToolTip="Muat ulang Windows Explorer jika taskbar macet">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Restart Explorer" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Kill Hanging Tasks -->
                        <Button x:Name="BtnHeaderKillTasks" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="BtnHeaderKillTasks_Click" ToolTip="Tutup paksa aplikasi yang berstatus Not Responding">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconKill}" Fill="{StaticResource BrushDanger}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Bunuh Task Macet" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Create Restore Point -->
                        <Button x:Name="BtnHeaderRestorePoint" Style="{StaticResource AccentButton}" Height="34" Padding="12,0" Click="BtnHeaderRestorePoint_Click" ToolTip="Buat System Restore Point Windows baru untuk keamanan sistem">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Buat Restore Point" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Content Area -->
            <ContentControl x:Name="MainContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
